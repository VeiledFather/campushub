IST = ZoneInfo("Asia/Kolkata")

EVENT_CREATOR_ROLES = {
    "teacher", "organizer", "admin", "super_admin", "developer"
}
ADMIN_ROLES = {"admin", "super_admin", "developer"}


def role_required(*roles):
    def decorator(view):
        @wraps(view)
        @login_required
        def wrapped(*args, **kwargs):
            if current_user.role not in roles:
                abort(403)
            return view(*args, **kwargs)
        return wrapped
    return decorator


def valid_statuses():
    result = set()
    for item in EVENT_STATUSES:
        result.add(item[0] if isinstance(item, (tuple, list)) else item)
    return result


def choose_status(*candidates):
    allowed = valid_statuses()
    for candidate in candidates:
        if candidate in allowed:
            return candidate
    raise RuntimeError(
        f"None of these statuses are configured in EVENT_STATUSES: {candidates}. "
        f"Configured statuses: {sorted(allowed)}"
    )


def utc_now():
    return datetime.now(timezone.utc).replace(tzinfo=None)


def parse_ist_datetime(value):
    """Convert a datetime-local form value from IST to naive UTC for storage."""
    if not value:
        return None
    local = datetime.fromisoformat(value).replace(tzinfo=IST)
    return local.astimezone(timezone.utc).replace(tzinfo=None)


def create_event_notification(
    recipient_id, notification_type, title, message, event_id
):
    """Create an in-app notification linked to an event."""
    if not recipient_id:
        return

    notification = Notification(
        recipient_id=recipient_id,
        notification_type=notification_type,
        title=title[:200],
        message=message,
        related_event_id=event_id,
    )
    db.session.add(notification)



def find_event_conflicts(venue_id, host_user_id, start_time, end_time, exclude_event_id=None):
    """Find overlapping venue bookings and organizer schedules."""
    query = Event.query.filter(
        Event.status.notin_(("cancelled", "completed")),
        Event.start_time < end_time,
        Event.end_time > start_time,
    )

    if exclude_event_id is not None:
        query = query.filter(Event.id != exclude_event_id)

    overlaps = query.all()
    conflicts = []

    for other in overlaps:
        venue_name = other.venue.name if other.venue else "Unknown venue"
        start_label = other.start_time.strftime("%d %b %Y, %I:%M %p") if other.start_time else "Unscheduled"
        end_label = other.end_time.strftime("%I:%M %p") if other.end_time else ""

        details = (
            f'"{other.title}" at {venue_name}, '
            f'{start_label}{(" – " + end_label) if end_label else ""}'
        )

        if other.venue_id == venue_id:
            conflicts.append({
                "type": "venue",
                "event": other,
                "message": f"Venue conflict: {details}.",
            })

        if other.host_user_id == host_user_id:
            conflicts.append({
                "type": "organizer",
                "event": other,
                "message": f"Organizer schedule conflict: {details}.",
            })

    return conflicts


def event_is_full(event):
    if event.max_participants is None:
        return False

    active_student_count = Registration.query.filter(
        Registration.event_id == event.id,
        Registration.status != "cancelled",
    ).count()

    # Teachers and students share the event's participant limit.
    active_teacher_count = TeacherEventParticipation.query.filter_by(
        event_id=event.id,
        status="registered",
    ).count()

    return (
        active_student_count + active_teacher_count
        >= event.max_participants
    )

def registration_is_open(event):
    now = utc_now()
    return (
        event.status == "published"
        and event.is_public
        and (event.registration_start is None or event.registration_start <= now)
        and (event.registration_end is None or event.registration_end >= now)
        and (event.start_time is None or event.start_time > now)
    )


