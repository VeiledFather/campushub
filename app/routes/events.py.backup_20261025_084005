@events_bp.post("/<int:event_id>/approve")
@role_required(*ADMIN_ROLES)
def approve(event_id):
    event = db.session.get(Event, event_id)
    if not event:
        abort(404)

    review_statuses = {
        status for status in ("pending_approval", "pending")
        if status in valid_statuses()
    }
    if event.status not in review_statuses:
        flash("This event is not awaiting approval.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    # Approval is distinct from publication.
    event.approval_required = True
    event.status = choose_status("approved", "draft")

    create_event_notification(
        recipient_id=event.host_user_id,
        notification_type="event_approved",
        title="Event approved",
        message=f'Your event "{event.title}" has been approved and is ready to publish.',
        event_id=event.id,
    )
    db.session.commit()
    flash("Event approved. It still needs to be published.", "success")
    return redirect(url_for("events.detail", event_id=event.id))


@events_bp.post("/<int:event_id>/publish")
@role_required(*EVENT_CREATOR_ROLES)
def publish(event_id):
    event = db.session.get(Event, event_id)
    if not event:
        abort(404)

    if current_user.role not in ADMIN_ROLES and event.host_user_id != current_user.id:
        abort(403)

    if event.approval_required and event.status not in {"approved", "published"}:
        flash("This event must be approved by an administrator before publishing.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    if event.status not in {"draft", "approved", "published"}:
        flash("This event cannot be published in its current state.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    event.status = choose_status("published")
    event.published_at = utc_now()
    db.session.commit()
    flash("Event published successfully.", "success")
    return redirect(url_for("events.detail", event_id=event.id))


@events_bp.post("/<int:event_id>/reject")
@role_required(*ADMIN_ROLES)
def reject(event_id):
    event = db.session.get(Event, event_id)
    if not event:
        abort(404)

    if event.status not in {"pending_approval", "pending", "draft"}:
        flash("Only events awaiting review can be rejected.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    reason = request.form.get("reason", "").strip()
    if not reason:
        flash("Provide feedback explaining why the event was rejected.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    event.status = choose_status("draft")
    event.approval_required = True
    event.cancellation_reason = reason[:2000]

    create_event_notification(
        recipient_id=event.host_user_id,
        notification_type="event_rejected",
        title="Event needs changes",
        message=f'Your event "{event.title}" needs changes before approval. Feedback: {reason[:2000]}',
        event_id=event.id,
    )
    db.session.commit()

    flash("Event returned to draft with your feedback.", "success")
    return redirect(url_for("events.detail", event_id=event.id))


@events_bp.post("/<int:event_id>/cancel")
@role_required(*EVENT_CREATOR_ROLES)
def cancel(event_id):
    event = db.session.get(Event, event_id)
    if not event:
        abort(404)

    if current_user.role not in ADMIN_ROLES and event.host_user_id != current_user.id:
        abort(403)

    if event.status in {"completed", "cancelled"}:
        flash("This event has already ended or been cancelled.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    reason = request.form.get("reason", "").strip()
    if not reason:
        flash("Provide a reason for cancelling the event.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    event.status = choose_status("cancelled")
    event.is_public = False
    event.cancelled_at = utc_now()
    event.cancellation_reason = reason[:2000]

    # Notify the organizer when an administrator cancels their event.
    if current_user.id != event.host_user_id:
        create_event_notification(
            recipient_id=event.host_user_id,
            notification_type="event_cancelled",
            title="Your event was cancelled",
            message=f'Your event "{event.title}" was cancelled. Reason: {reason[:2000]}',
            event_id=event.id,
        )

    # Notify students who have active registrations for this event.
    registrations = Registration.query.filter(
        Registration.event_id == event.id,
        Registration.status != "cancelled",
    ).all()

    notified_students = set()
    for registration in registrations:
        student = db.session.get(Student, registration.student_id)
        if not student or not student.user_id:
            continue

        recipient_id = student.user_id
        if recipient_id in notified_students or recipient_id == current_user.id:
            continue

        notified_students.add(recipient_id)
        create_event_notification(
            recipient_id=recipient_id,
            notification_type="event_cancelled",
            title="An event you registered for was cancelled",
            message=f'"{event.title}" has been cancelled. Reason: {reason[:2000]}',
            event_id=event.id,
        )

    db.session.commit()

    flash("Event cancelled and removed from public listings. Notifications sent.", "success")
    return redirect(url_for("events.detail", event_id=event.id))


@events_bp.post("/<int:event_id>/resubmit")
@role_required(*EVENT_CREATOR_ROLES)
def resubmit(event_id):
    event = db.session.get(Event, event_id)
    if not event:
        abort(404)

    if current_user.role not in ADMIN_ROLES and event.host_user_id != current_user.id:
        abort(403)

    if (
        event.status != "draft"
        or not event.approval_required
        or not event.cancellation_reason
    ):
        flash("Only a rejected event with review feedback can be resubmitted.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    event.status = choose_status("pending_approval", "pending", "draft")
    event.cancellation_reason = None
    db.session.commit()

    flash("Event resubmitted for administrator review.", "success")
    return redirect(url_for("events.detail", event_id=event.id))


@events_bp.post("/<int:event_id>/register")
@role_required("student")
def register_for_event(event_id):
    event = db.session.get(Event, event_id)
    if not event:
        abort(404)

    student = Student.query.filter_by(user_id=current_user.id).first()
    if not student:
        flash("Your account needs a student profile before you can register. Contact your campus administrator.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    if not student.campus_id_active:
        flash("Your campus ID is inactive. Contact your campus administrator.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    if not registration_is_open(event):
        flash("Registration is not currently open for this event.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    existing = Registration.query.filter_by(
        event_id=event.id,
        student_id=student.id,
    ).first()

    if existing and existing.status != "cancelled":
        flash("You are already registered for this event.", "info")
        return redirect(url_for("events.detail", event_id=event.id))

    if event_is_full(event):
        flash("This event has reached its participant limit.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    if existing and existing.ticket and existing.ticket.checked_in_at:
        flash("This registration has already been checked in and cannot be reactivated.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    if existing:
        registration = existing
        registration.status = "registered"
        registration.registered_at = utc_now()
    else:
        registration = Registration(
            event_id=event.id,
            student_id=student.id,
            status="registered",
            registered_at=utc_now(),
        )
        db.session.add(registration)

    # Save the registration first so it has an ID for its one-to-one ticket.
    db.session.flush()

    if event.ticket_required:
        ticket = Ticket.query.filter_by(registration_id=registration.id).first()
        if ticket is None:
            ticket = Ticket(
                registration_id=registration.id,
                ticket_code="CHT-" + uuid4().hex[:16].upper(),
                qr_token=__import__("secrets").token_urlsafe(32),
                status="active",
                expires_at=event.end_time,
            )
            db.session.add(ticket)
        else:
            ticket.ticket_code = "CHT-" + uuid4().hex[:16].upper()
            ticket.qr_token = __import__("secrets").token_urlsafe(32)
            ticket.status = "active"
            ticket.checked_in_at = None
            ticket.expires_at = event.end_time

    db.session.commit()
    flash("You are registered for the event!", "success")
    return redirect(url_for("events.detail", event_id=event.id))
