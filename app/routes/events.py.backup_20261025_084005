@events_bp.route("/new", methods=["GET", "POST"])
@role_required(*EVENT_CREATOR_ROLES)
def create():
    venues = Venue.query.filter_by(
        is_active=True,
        is_event_venue=True,
    ).order_by(Venue.name.asc()).all()

    # Prefill from a saved EvAi plan owned by the current user.
    saved_plan = None
    saved_plan_id = request.args.get("saved_plan_id", type=int)
    if saved_plan_id:
        import json
        from app.models import EvAiSavedPlan

        saved_record = EvAiSavedPlan.query.filter_by(
            id=saved_plan_id,
            user_id=current_user.id,
        ).first()

        if saved_record:
            try:
                saved_plan = json.loads(saved_record.plan_json)
                if not isinstance(saved_plan, dict):
                    saved_plan = None
            except (TypeError, ValueError):
                saved_plan = None

    if request.method == "POST":
        title = request.form.get("title", "").strip()
        description = request.form.get("description", "").strip()
        event_type = request.form.get("event_type", "general").strip() or "general"
        food = request.form.get("food_requirements", "").strip() or None
        equipment = request.form.get("equipment_requirements", "").strip() or None

        try:
            venue_id = int(request.form.get("venue_id", ""))
            venue = db.session.get(Venue, venue_id)
            start = parse_ist_datetime(request.form.get("start_time", ""))
            end = parse_ist_datetime(request.form.get("end_time", ""))
            reg_start = parse_ist_datetime(request.form.get("registration_start", ""))
            reg_end = parse_ist_datetime(request.form.get("registration_end", ""))
            capacity_text = request.form.get("max_participants", "").strip()
            capacity = int(capacity_text) if capacity_text else None
        except (ValueError, TypeError, OverflowError):
            flash("Check the venue, dates, and participant limit.", "error")
            return render_template("events/create.html", venues=venues, saved_plan=saved_plan)

        if not title or len(title) > 200:
            flash("Enter an event title of up to 200 characters.", "error")
        elif len(event_type) > 80:
            flash("Event type must be 80 characters or fewer.", "error")
        elif not venue or not venue.is_active or not venue.is_event_venue:
            flash("Choose an active event venue.", "error")
        elif not start or not end or end <= start:
            flash("The end time must be later than the start time.", "error")
        elif reg_start and reg_end and reg_end < reg_start:
            flash("Registration closing time must follow its opening time.", "error")
        elif reg_end and reg_end > start:
            flash("Registration must close before the event starts.", "error")
        elif capacity is not None and (capacity < 1 or capacity > venue.capacity):
            flash(f"Participant limit must be between 1 and the venue capacity ({venue.capacity}).", "error")
        else:
            conflicts = find_event_conflicts(
                venue_id=venue.id,
                host_user_id=current_user.id,
                start_time=start,
                end_time=end,
            )
            if conflicts:
                for conflict in conflicts:
                    flash(conflict["message"], "error")
            else:
                approval_required = (
                    request.form.get("approval_required") == "yes"
                )
                initial_status = choose_status(
                    "pending_approval", "pending", "draft"
                ) if approval_required else choose_status("draft")

                event = Event(
                    event_code="CH-" + uuid4().hex[:12].upper(),
                    title=title,
                    description=description,
                    event_type=event_type,
                    venue_id=venue.id,
                    host_user_id=current_user.id,
                    start_time=start,
                    end_time=end,
                    registration_start=reg_start,
                    registration_end=reg_end,
                    max_participants=capacity,
                    ticket_required=request.form.get("ticket_required") == "yes",
                    approval_required=approval_required,
                    is_public=request.form.get("is_public") == "yes",
                    status=initial_status,
                    food_requirements=food,
                    equipment_requirements=equipment,
                )
                db.session.add(event)
                db.session.flush()

                if approval_required and event.status in {"pending_approval", "pending"}:
                    admins = User.query.filter(
                        User.role.in_(ADMIN_ROLES),
                        User.is_active.is_(True),
                        User.is_suspended.is_(False),
                    ).all()

                    for admin in admins:
                        if admin.id != current_user.id:
                            create_event_notification(
                                recipient_id=admin.id,
                                notification_type="event_pending_review",
                                title="Event awaiting approval",
                                message=f'"{event.title}" was submitted by {current_user.full_name} and needs review.',
                                event_id=event.id,
                            )

                db.session.commit()

                flash("Event created. Review its status and submit it for approval if required.", "success")
                return redirect(url_for("events.detail", event_id=event.id))

    return render_template("events/create.html", venues=venues, saved_plan=saved_plan)


@events_bp.get("/<int:event_id>")
def detail(event_id):
    event = db.session.get(Event, event_id)
    if not event:
        abort(404)

    if not event.is_public and (
        not current_user.is_authenticated
        or (
            current_user.id != event.host_user_id
            and current_user.role not in ADMIN_ROLES
        )
    ):
        abort(404)

    already_registered = False
    student = None
    student_registration = None
    user_review = None

    if current_user.is_authenticated and current_user.role == "student":
        student = Student.query.filter_by(user_id=current_user.id).first()
        if student:
            student_registration = Registration.query.filter_by(
                event_id=event.id,
                student_id=student.id,
            ).filter(Registration.status != "cancelled").first()
            already_registered = student_registration is not None

            user_review = Review.query.filter_by(
                event_id=event.id,
                student_id=student.id,
            ).first()

    can_manage = current_user.is_authenticated and (
        current_user.role in ADMIN_ROLES
        or (
            current_user.role in EVENT_CREATOR_ROLES
            and current_user.id == event.host_user_id
        )
    )

    reviews = (
        Review.query.filter_by(event_id=event.id)
        .order_by(Review.id.desc())
        .all()
    )
    average_rating = (
        db.session.query(func.avg(Review.rating))
        .filter(Review.event_id == event.id)
        .scalar()
    )

    can_review = (
        current_user.is_authenticated
        and current_user.role == "student"
        and student is not None
        and student_registration is not None
        and event.status == "completed"
        and user_review is None
    )

    return render_template(
        "events/detail.html",
        event=event,
        already_registered=already_registered,
        student=student,
        student_registration=student_registration,
        can_manage=can_manage,
        registration_open=registration_is_open(event),
        event_full=event_is_full(event),
        reviews=reviews,
        average_rating=average_rating,
        user_review=user_review,
        can_review=can_review,
    )


@events_bp.post("/<int:event_id>/reviews")
@role_required("student")
def submit_review(event_id):
    event = db.session.get(Event, event_id)
    if not event:
        abort(404)

    if event.status != "completed":
        flash("You can review an event after it has been completed.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    student = Student.query.filter_by(user_id=current_user.id).first()
    if not student:
        flash("Your account needs a linked student profile to submit a review.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    registration = Registration.query.filter_by(
        event_id=event.id,
        student_id=student.id,
    ).filter(Registration.status != "cancelled").first()

    if not registration:
        abort(403)

    if Review.query.filter_by(
        event_id=event.id,
        student_id=student.id,
    ).first():
        flash("You have already reviewed this event.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    try:
        rating = int(request.form.get("rating", ""))
    except (TypeError, ValueError):
        rating = 0

    feedback = request.form.get("feedback", "").strip()

    if rating not in range(1, 6):
        flash("Choose a rating from 1 to 5 stars.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    if len(feedback) > 2000:
        flash("Feedback must be 2,000 characters or fewer.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    db.session.add(
        Review(
            event_id=event.id,
            student_id=student.id,
            rating=rating,
            feedback=feedback or None,
        )
    )

    try:
        db.session.commit()
    except IntegrityError:
        db.session.rollback()
        flash("You have already reviewed this event.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    flash("Thanks! Your event review has been submitted.", "success")
    return redirect(url_for("events.detail", event_id=event.id))


@events_bp.route("/<int:event_id>/edit", methods=["GET", "POST"])
@role_required(*EVENT_CREATOR_ROLES)
def edit(event_id):
    event = db.session.get(Event, event_id)
    if not event:
        abort(404)

    if current_user.role not in ADMIN_ROLES and event.host_user_id != current_user.id:
        abort(403)

    if event.status in {"completed", "cancelled", "ongoing"}:
        flash("This event can no longer be edited.", "error")
        return redirect(url_for("events.detail", event_id=event.id))

    venues = Venue.query.filter_by(
        is_active=True,
        is_event_venue=True,
    ).order_by(Venue.name.asc()).all()

    if request.method == "POST":
        title = request.form.get("title", "").strip()
        description = request.form.get("description", "").strip()
        event_type = request.form.get("event_type", "general").strip() or "general"
        food = request.form.get("food_requirements", "").strip() or None
        equipment = request.form.get("equipment_requirements", "").strip() or None

        try:
            venue_id = int(request.form.get("venue_id", ""))
            venue = db.session.get(Venue, venue_id)
            start = parse_ist_datetime(request.form.get("start_time", ""))
            end = parse_ist_datetime(request.form.get("end_time", ""))
            reg_start = parse_ist_datetime(request.form.get("registration_start", ""))
            reg_end = parse_ist_datetime(request.form.get("registration_end", ""))
            capacity_text = request.form.get("max_participants", "").strip()
            capacity = int(capacity_text) if capacity_text else None
        except (ValueError, TypeError, OverflowError):
            flash("Check the venue, dates, and participant limit.", "error")
            return render_template("events/edit.html", event=event, venues=venues)

        error = None
        if not title or len(title) > 200:
            error = "Enter an event title of up to 200 characters."
        elif len(event_type) > 80:
            error = "Event type must be 80 characters or fewer."
        elif not venue or not venue.is_active or not venue.is_event_venue:
            error = "Choose an active event venue."
        elif not start or not end or end <= start:
            error = "The end time must be later than the start time."
        elif reg_start and reg_end and reg_end < reg_start:
            error = "Registration closing time must follow its opening time."
        elif reg_end and reg_end > start:
            error = "Registration must close before the event starts."
        elif capacity is not None and (capacity < 1 or capacity > venue.capacity):
            error = f"Participant limit must be between 1 and venue capacity ({venue.capacity})."

        if error:
            flash(error, "error")
        else:
            conflicts = find_event_conflicts(
                venue_id=venue.id,
                host_user_id=event.host_user_id,
                start_time=start,
                end_time=end,
                exclude_event_id=event.id,
            )
            if conflicts:
                for conflict in conflicts:
                    flash(conflict["message"], "error")
            else:
                event.title = title
                event.description = description
                event.event_type = event_type
                event.venue_id = venue.id
                event.start_time = start
                event.end_time = end
                event.registration_start = reg_start
                event.registration_end = reg_end
                event.max_participants = capacity
                event.ticket_required = request.form.get("ticket_required") == "yes"
                event.is_public = request.form.get("is_public") == "yes"
                event.food_requirements = food
                event.equipment_requirements = equipment

                # Material edits to a published event require a fresh review.
                if event.status in {"published", "approved"}:
                    if event.approval_required:
                        event.status = choose_status("pending_approval", "pending", "draft")
                    else:
                        event.status = choose_status("draft")
                    event.published_at = None

            db.session.commit()
            flash("Event updated successfully.", "success")
            return redirect(url_for("events.detail", event_id=event.id))

    return render_template("events/edit.html", event=event, venues=venues)


@events_bp.get("/notifications")
@login_required
def notification_inbox():
    notifications = (
        Notification.query
        .filter_by(recipient_id=current_user.id)
        .order_by(Notification.created_at.desc())
        .all()
    )
    unread_count = sum(not notification.is_read for notification in notifications)

    return render_template(
        "events/notifications.html",
        notifications=notifications,
        unread_count=unread_count,
    )


@events_bp.post("/notifications/<int:notification_id>/read")
@login_required
def mark_notification_read(notification_id):
    notification = db.session.get(Notification, notification_id)
    if not notification:
        abort(404)

    if notification.recipient_id != current_user.id:
        abort(403)

    if not notification.is_read:
        notification.is_read = True
        notification.read_at = utc_now()
        db.session.commit()

    # Open only events that are public and currently published.
    # Private or unavailable events should not send the user to a 404 page.
    event = notification.related_event
    if event and event.is_public and event.status == "published":
        return redirect(url_for(
            "events.detail",
            event_id=event.id,
        ))

    return redirect(url_for("events.notification_inbox"))


