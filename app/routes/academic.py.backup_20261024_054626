from functools import wraps

from flask import (
    Blueprint, abort, current_app, flash, redirect, render_template,
    request, url_for,
)
from flask_login import current_user, login_required
from sqlalchemy import or_
from sqlalchemy.exc import IntegrityError

from app.extensions import db
from app.models import User, Student, Teacher, Department, Batch, Venue, Event, TeacherEventParticipation

academic_bp = Blueprint("academic", __name__, url_prefix="/academic")

ADMIN_ROLES = {"admin", "super_admin", "developer"}


def admin_required(view):
    @wraps(view)
    @login_required
    def wrapped(*args, **kwargs):
        if current_user.role not in ADMIN_ROLES:
            abort(403)
        return view(*args, **kwargs)
    return wrapped


@academic_bp.get("/")
@admin_required
def index():
    student_search = request.args.get("student_search", "").strip()
    department_filter = request.args.get("department_id", type=int)
    batch_filter = request.args.get("student_batch_id", type=int)
    verification_filter = request.args.get("verification", "")
    id_status_filter = request.args.get("id_status", "")

    student_query = Student.query.join(User, Student.user_id == User.id)

    if student_search:
        pattern = f"%{student_search}%"
        student_query = student_query.filter(or_(
            User.full_name.ilike(pattern),
            User.email.ilike(pattern),
            Student.campus_id.ilike(pattern),
            Student.college_id.ilike(pattern),
        ))

    if department_filter:
        student_query = student_query.join(Batch, Student.batch_id == Batch.id)
        student_query = student_query.filter(
            Batch.department_id == department_filter
        )

    if batch_filter:
        student_query = student_query.filter(
            Student.batch_id == batch_filter
        )

    if verification_filter == "verified":
        student_query = student_query.filter(Student.id_verified.is_(True))
    elif verification_filter == "unverified":
        student_query = student_query.filter(Student.id_verified.is_(False))

    if id_status_filter == "active":
        student_query = student_query.filter(Student.campus_id_active.is_(True))
    elif id_status_filter == "inactive":
        student_query = student_query.filter(Student.campus_id_active.is_(False))

    return render_template(
        "academic/index.html",
        departments=Department.query.order_by(Department.name).all(),
        batches=Batch.query.order_by(Batch.name).all(),
        students=student_query.order_by(Student.id.desc()).all(),
        student_search=student_search,
        department_filter=department_filter,
        batch_filter=batch_filter,
        verification_filter=verification_filter,
        id_status_filter=id_status_filter,
        teachers=Teacher.query.order_by(Teacher.id.desc()).all(),
        venues=Venue.query.order_by(Venue.name).all(),
        student_users=User.query.filter_by(role="student").order_by(User.email).all(),
        teacher_users=User.query.filter_by(role="teacher").order_by(User.email).all(),
    )


@academic_bp.post("/departments")
@admin_required
def create_department():
    name = request.form.get("name", "").strip()
    code = request.form.get("code", "").strip().upper()

    if not name or len(name) > 160 or not code or len(code) > 30:
        flash("Enter a valid department name and code.", "error")
        return redirect(url_for("academic.index"))

    if Department.query.filter_by(code=code).first():
        flash("That department code already exists.", "error")
        return redirect(url_for("academic.index"))

    db.session.add(Department(name=name, code=code, is_active=True))
    try:
        db.session.commit()
        flash("Department created.", "success")
    except IntegrityError:
        db.session.rollback()
        flash("Could not create the department; check for duplicate values.", "error")

    return redirect(url_for("academic.index"))


@academic_bp.post("/batches")
@admin_required
def create_batch():
    name = request.form.get("name", "").strip()
    academic_year = request.form.get("academic_year", "").strip()
    department_id = request.form.get("department_id", type=int)

    if not name or len(name) > 100 or not academic_year or len(academic_year) > 30:
        flash("Enter a valid batch name and academic year.", "error")
        return redirect(url_for("academic.index"))

    department = db.session.get(Department, department_id) if department_id else None
    if department is None or not department.is_active:
        flash("Choose an active department.", "error")
