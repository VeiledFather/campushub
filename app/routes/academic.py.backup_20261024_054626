    ))
    try:
        db.session.commit()
        flash("Batch created.", "success")
    except IntegrityError:
        db.session.rollback()
        flash("Could not create the batch.", "error")

    return redirect(url_for("academic.index"))


@academic_bp.post("/batches/<int:batch_id>/edit")
@admin_required
def edit_batch(batch_id):
    from datetime import date

    batch = db.session.get(Batch, batch_id)
    if batch is None:
        abort(404)

    name = request.form.get("name", "").strip()
    academic_year = request.form.get("academic_year", "").strip()
    department_id = request.form.get("department_id", type=int)
    home_room = request.form.get("home_room", "").strip()

    if (
        not name or len(name) > 100
        or not academic_year or len(academic_year) > 30
        or len(home_room) > 100
    ):
        flash("Enter a valid batch name, academic year, and homeroom.", "error")
        return redirect(url_for("academic.index"))

    department = db.session.get(Department, department_id) if department_id else None
    if department is None or not department.is_active:
        flash("Choose an active department.", "error")
        return redirect(url_for("academic.index"))

    duplicate = Batch.query.filter(
        Batch.name == name,
        Batch.academic_year == academic_year,
        Batch.department_id == department.id,
        Batch.id != batch.id,
    ).first()

    if duplicate:
        flash("That batch already exists for this department and year.", "error")
        return redirect(url_for("academic.index"))

    parsed_dates = {}
    for field in ("start_date", "end_date", "id_expiry_date"):
        raw_value = request.form.get(field, "").strip()
        if raw_value:
            try:
                parsed_dates[field] = date.fromisoformat(raw_value)
            except ValueError:
                flash("Enter valid dates for the batch.", "error")
                return redirect(url_for("academic.index"))
        else:
            parsed_dates[field] = None

    start_date = parsed_dates["start_date"]
    end_date = parsed_dates["end_date"]
    if start_date and end_date and end_date < start_date:
        flash("Batch end date cannot be earlier than its start date.", "error")
        return redirect(url_for("academic.index"))

    batch.name = name
    batch.academic_year = academic_year
    batch.department_id = department.id
    batch.home_room = home_room or None
    batch.start_date = start_date
    batch.end_date = end_date
    batch.id_expiry_date = parsed_dates["id_expiry_date"]

    try:
        db.session.commit()
        flash("Batch updated. Existing student and teacher assignments were preserved.", "success")
    except IntegrityError:
        db.session.rollback()
        flash("Could not update the batch.", "error")

    return redirect(url_for("academic.index"))


