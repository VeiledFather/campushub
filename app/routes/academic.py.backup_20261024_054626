def _send_teacher_enrolled_student_setup_email(user):
    """Send a student the same signed, one-hour setup link used by admins."""
    import smtplib
    from email.message import EmailMessage
    from itsdangerous import URLSafeTimedSerializer

    mail_server = current_app.config.get("MAIL_SERVER", "")
    mail_port = int(current_app.config.get("MAIL_PORT", 587))
    mail_username = current_app.config.get("MAIL_USERNAME", "")
    mail_password = current_app.config.get("MAIL_PASSWORD", "")
    sender = current_app.config.get("MAIL_DEFAULT_SENDER") or mail_username

    if not mail_server or not sender:
        current_app.logger.warning(
            "Teacher enrollment setup email skipped: SMTP is not configured."
        )
        return False

    serializer = URLSafeTimedSerializer(current_app.config["SECRET_KEY"])
    token = serializer.dumps(
        {"user_id": user.id, "password_hash": user.password_hash},
        salt="campushub-student-password-setup",
    )
    setup_url = url_for("auth.password_setup", token=token, _external=True)

    message = EmailMessage()
    message["Subject"] = "Set up your CampusHub student account"
    message["From"] = sender
    message["To"] = user.email
    message.set_content(
        f"Hello {user.full_name},\n\n"
        "Your CampusHub student account has been created.\n"
        "Use the link below within one hour to create your password:\n\n"
        f"{setup_url}\n\n"
        "Your Campus ID is not verified automatically by account setup. "
        "Contact your campus administrator if you need help."
    )

    try:
        if mail_port == 465:
            connection = smtplib.SMTP_SSL(
                mail_server, mail_port, timeout=20
            )
        else:
            connection = smtplib.SMTP(
                mail_server, mail_port, timeout=20
            )
            connection.starttls()

        with connection as smtp:
            if mail_username:
                smtp.login(mail_username, mail_password)
            smtp.send_message(message)

        return True
    except Exception:
        current_app.logger.exception(
            "Could not send password setup email after teacher enrollment."
        )
        return False


@academic_bp.route("/teacher", methods=["GET", "POST"])
@login_required
def teacher_workspace():
    """Teacher workspace limited to the teacher's assigned homeroom batch."""
    import secrets
    from werkzeug.security import generate_password_hash

    if current_user.role != "teacher":
        abort(403)

    teacher = Teacher.query.filter_by(user_id=current_user.id).first()
    if teacher is None or teacher.homeroom_batch is None:
        return render_template(
            "academic/teacher.html",
            teacher=teacher,
            batch=None,
            students=[],
            error_message=(
                "Your teacher profile needs an assigned homeroom batch. "
                "Contact an administrator before enrolling students."
            ),
        ), 200

    batch = teacher.homeroom_batch

    # Faculty identity must be verified before accessing student records
    # or performing enrollment actions.
    if not teacher.id_verified:
        return render_template(
            "academic/teacher.html",
            teacher=teacher,
            batch=None,
            students=[],
            error_message=(
                "Your faculty identity has not been verified yet. "
                "Contact an administrator to complete verification."
            ),
        ), 403

    if request.method == "POST":
        if not batch.is_active:
            abort(403)

        full_name = request.form.get("full_name", "").strip()
        email = request.form.get("email", "").strip().lower()
        campus_id = request.form.get("campus_id", "").strip()
        college_id = request.form.get("college_id", "").strip()

        if not full_name or len(full_name) > 160:
            flash("Enter a valid student name.", "error")
        elif not email or len(email) > 255 or "@" not in email:
            flash("Enter a valid student email address.", "error")
        elif not campus_id or len(campus_id) > 80:
            flash("Enter a valid Campus ID.", "error")
        elif not college_id or len(college_id) > 80:
            flash("Enter a valid College ID.", "error")
        elif User.query.filter(__import__("sqlalchemy").func.lower(User.email) == email).first():
            flash("An account with that email already exists.", "error")
        elif Student.query.filter(
            __import__("sqlalchemy").or_(
                Student.campus_id == campus_id,
                Student.college_id == college_id,
            )
        ).first():
            flash("That Campus ID or College ID is already assigned.", "error")
        else:
            # One transaction creates the account and its student profile.
            user = User(
                full_name=full_name,
                email=email,
                password_hash=generate_password_hash(secrets.token_urlsafe(32)),
                role="student",
                is_active=True,
                is_suspended=False,
            )
            db.session.add(user)
            try:
                db.session.flush()
                student = Student(
                    user_id=user.id,
                    campus_id=campus_id,
                    college_id=college_id,
                    batch_id=batch.id,
                    id_verified=False,
                    campus_id_active=True,
                )
                db.session.add(student)
                db.session.commit()

                if _send_teacher_enrolled_student_setup_email(user):
                    flash(
                        "Student enrolled successfully. A one-hour password "
                        "setup link was emailed to the student. Campus ID "
                        "verification remains pending.",
                        "success",
                    )
                else:
                    flash(
                        "Student enrolled successfully, but the password setup "
                        "email could not be sent. Check SMTP configuration and "
                        "application logs, then use the admin resend-link action. "
                        "Campus ID verification remains pending.",
                        "warning",
                    )
                return redirect(url_for("academic.teacher_workspace"))
            except IntegrityError:
                db.session.rollback()
                flash(
                    "Enrollment could not be completed because a record may "
                    "already exist. Check the email and ID values.",
                    "error",
                )

    students = (
        Student.query.filter_by(batch_id=batch.id)
        .order_by(Student.id.desc())
        .all()
    )
    return render_template(
        "academic/teacher.html",
        teacher=teacher,
        batch=batch,
        students=students,
        error_message=None,
    )


@academic_bp.route("/teacher/events", methods=["GET", "POST"])
@login_required
def teacher_event_participation():
    """Allow verified teachers to register for published campus events."""
    if current_user.role != "teacher":
        abort(403)

    teacher = Teacher.query.filter_by(user_id=current_user.id).first()
    if teacher is None or not teacher.id_verified:
        abort(403)

    if request.method == "POST":
        action = request.form.get("action", "")
        event_id = request.form.get("event_id", type=int)

        if action not in {"register", "withdraw"} or not event_id:
            abort(400)

        event = db.session.get(Event, event_id)
        if event is None or event.status not in {"published", "ongoing"}:
            flash("That event is not currently open for participation.", "error")
            return redirect(url_for("academic.teacher_event_participation"))

        record = TeacherEventParticipation.query.filter_by(
            event_id=event.id, teacher_id=teacher.id
        ).first()

        if action == "register":
            if record is None:
                record = TeacherEventParticipation(
                    event_id=event.id, teacher_id=teacher.id,
                    status="registered",
                )
                db.session.add(record)
            else:
                record.status = "registered"

            try:
                db.session.commit()
                flash("You are registered for the event.", "success")
            except IntegrityError:
                db.session.rollback()
                flash("Registration could not be saved. Please try again.", "error")
        else:
            if record is not None and record.status == "registered":
                record.status = "withdrawn"
                db.session.commit()
                flash("You have withdrawn from the event.", "success")
            else:
                flash("You have no active registration for this event.", "warning")

        return redirect(url_for("academic.teacher_event_participation"))

    events = (
        Event.query
        .filter(Event.status.in_(["published", "ongoing"]))
        .order_by(Event.start_time.asc())
        .all()
    )
    records = TeacherEventParticipation.query.filter_by(
        teacher_id=teacher.id
    ).all()

    return render_template(
        "academic/teacher_events.html",
        teacher=teacher,
        events=events,
        participation_by_event={r.event_id: r.status for r in records},
    )
