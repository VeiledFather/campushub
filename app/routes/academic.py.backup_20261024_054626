@academic_bp.post("/students/import-csv")
@admin_required
def import_students_csv():
    import csv
    import io
    import secrets
    import string

    from werkzeug.security import generate_password_hash

    upload = request.files.get("csv_file")
    batch_id = request.form.get("batch_id", type=int)

    if not upload or not upload.filename:
        flash("Choose a CSV file to import.", "error")
        return redirect(url_for("academic.index"))

    if not upload.filename.lower().endswith(".csv"):
        flash("Upload a .csv file.", "error")
        return redirect(url_for("academic.index"))

    batch = db.session.get(Batch, batch_id) if batch_id else None
    if batch_id and (batch is None or not batch.is_active):
        flash("Choose an active batch, or leave batch assignment empty.", "error")
        return redirect(url_for("academic.index"))

    try:
        raw = upload.stream.read(2_000_001)
        if len(raw) > 2_000_000:
            flash("CSV file is too large. Maximum size is 2 MB.", "error")
            return redirect(url_for("academic.index"))

        content = raw.decode("utf-8-sig")
        reader = csv.DictReader(io.StringIO(content))
        required = {"full_name", "email", "campus_id", "college_id"}

        if not reader.fieldnames or not required.issubset(
            {name.strip().lower() for name in reader.fieldnames if name}
        ):
            flash(
                "CSV headers must include full_name,email,campus_id,college_id.",
                "error",
            )
            return redirect(url_for("academic.index"))

        # Normalize header names and ignore completely blank rows.
        reader.fieldnames = [name.strip().lower() for name in reader.fieldnames]
        rows = [
            {str(k).strip().lower(): (v or "").strip()
             for k, v in row.items() if k}
            for row in reader
        ]
    except (UnicodeDecodeError, csv.Error):
        flash("Could not read the CSV. Save it as UTF-8 CSV and try again.", "error")
        return redirect(url_for("academic.index"))

    rows = [row for row in rows if any(row.values())]
    if not rows:
        flash("The CSV contains no student rows.", "error")
        return redirect(url_for("academic.index"))

    if len(rows) > 1000:
        flash("Import is limited to 1,000 rows per upload.", "error")
        return redirect(url_for("academic.index"))

    created_accounts = 0
    created_profiles = 0
    linked_existing = 0
    skipped = 0
    errors = []
    new_accounts = []
    seen_emails = set()
    seen_campus_ids = set()
    seen_college_ids = set()

    alphabet = string.ascii_letters + string.digits + "!@#$%*-_"

    try:
        for line_number, row in enumerate(rows, start=2):
            name = row.get("full_name", "").strip()
            email = row.get("email", "").strip().lower()
            campus_id = row.get("campus_id", "").strip()
            college_id = row.get("college_id", "").strip()

            if (
                not name or len(name) > 160
                or "@" not in email or len(email) > 255
                or not campus_id or len(campus_id) > 80
                or not college_id or len(college_id) > 80
            ):
                errors.append(f"Row {line_number}: invalid or missing required field.")
                skipped += 1
                continue

            if email in seen_emails:
                errors.append(f"Row {line_number}: duplicate email in this CSV.")
                skipped += 1
                continue
            if campus_id in seen_campus_ids or Student.query.filter_by(
                campus_id=campus_id
            ).first():
                errors.append(f"Row {line_number}: duplicate Campus ID.")
                skipped += 1
                continue
            if college_id in seen_college_ids or Student.query.filter_by(
                college_id=college_id
            ).first():
                errors.append(f"Row {line_number}: duplicate College ID.")
                skipped += 1
                continue

            user = User.query.filter(
                __import__("sqlalchemy").func.lower(User.email) == email
            ).first()

            if user and user.role != "student":
                errors.append(
                    f"Row {line_number}: email belongs to a non-student account."
                )
                skipped += 1
                continue

            if user and user.student:
                errors.append(
                    f"Row {line_number}: student profile already exists; skipped."
                )
                skipped += 1
                continue

            if user is None:
                temporary_password = "".join(
                    secrets.choice(alphabet) for _ in range(24)
                )
                user = User(
                    full_name=name,
                    email=email,
                    password_hash=generate_password_hash(temporary_password),
                    role="student",
                    is_active=True,
                    is_suspended=False,
                )
                db.session.add(user)
                db.session.flush()
                new_accounts.append(
                    (user.id, user.password_hash, email, name)
                )
                created_accounts += 1
            else:
                # Link the existing student account without changing its password,
                # name, login status, or suspension status.
                linked_existing += 1

            student = Student(
                user_id=user.id,
                campus_id=campus_id,
                college_id=college_id,
                batch_id=batch.id if batch else None,
                id_verified=False,
                campus_id_active=True,
            )
            db.session.add(student)
            db.session.flush()

            seen_emails.add(email)
            seen_campus_ids.add(campus_id)
            seen_college_ids.add(college_id)
            created_profiles += 1

        db.session.commit()
    except Exception:
        db.session.rollback()
        current_app.logger.exception("Student CSV import failed")
        flash(
            "Import failed and its database changes were rolled back. "
            "Please review the CSV and try again.",
            "error",
        )
        return redirect(url_for("academic.index"))

    import smtplib
    from email.message import EmailMessage
    from itsdangerous import URLSafeTimedSerializer

    emails_sent = 0
    emails_failed = 0

    if new_accounts:
        server_name = current_app.config.get("MAIL_SERVER", "")
        mail_port = current_app.config.get("MAIL_PORT", 587)
        mail_user = current_app.config.get("MAIL_USERNAME", "")
        mail_password = current_app.config.get("MAIL_PASSWORD", "")
        sender = current_app.config.get("MAIL_DEFAULT_SENDER") or mail_user

        if not server_name or not sender:
            emails_failed = len(new_accounts)
            current_app.logger.warning(
                "Student setup emails not sent: SMTP server or sender is not configured."
            )
        else:
            serializer = URLSafeTimedSerializer(
                current_app.config["SECRET_KEY"]
            )
            try:
                if mail_port == 465:
                    connection = smtplib.SMTP_SSL(
                        server_name, mail_port, timeout=20
                    )
                else:
                    connection = smtplib.SMTP(
                        server_name, mail_port, timeout=20
                    )
                    connection.starttls()

                with connection as smtp:
                    if mail_user:
                        smtp.login(mail_user, mail_password)

                    for user_id, password_hash, email, name in new_accounts:
                        token = serializer.dumps(
                            {
                                "user_id": user_id,
                                "password_hash": password_hash,
                            },
                            salt="campushub-student-password-setup",
                        )
                        setup_url = url_for(
                            "auth.password_setup",
                            token=token,
                            _external=True,
                        )

                        message = EmailMessage()
                        message["Subject"] = "Set up your CampusHub student account"
                        message["From"] = sender
                        message["To"] = email
                        message.set_content(
                            f"Hello {name},\n\n"
                            "A CampusHub student account has been created for you.\n"
                            "Set your password using this secure link (valid for one hour):\n\n"
                            f"{setup_url}\n\n"
                            "If you weren't expecting this account, contact your campus administrator."
                        )
                        smtp.send_message(message)
                        emails_sent += 1

            except Exception:
                emails_failed = len(new_accounts) - emails_sent
                current_app.logger.exception(
                    "One or more student password setup emails could not be sent."
                )

    summary = (
        f"CSV import complete: {created_accounts} new accounts, "
        f"{created_profiles} profiles created, {linked_existing} existing "
        f"accounts linked, {skipped} rows skipped."
    )
    if new_accounts:
        summary += (
            f" Setup emails sent: {emails_sent}; email failures: {emails_failed}."
        )
    flash(summary, "success" if skipped == 0 else "warning")

    for message in errors[:15]:
        flash(message, "error")
    if len(errors) > 15:
        flash(f"{len(errors) - 15} additional row errors were omitted.", "warning")

    return redirect(url_for("academic.index"))


@academic_bp.post("/students/bulk-enroll")
@admin_required
def bulk_enroll_students():
    from sqlalchemy import select

    raw_ids = request.form.getlist("student_ids")
    action = request.form.get("enrollment_action", "assign").strip()
    batch_id = request.form.get("batch_id", type=int)

    try:
        student_ids = list({int(value) for value in raw_ids})
    except (TypeError, ValueError):
        flash("Invalid student selection.", "error")
        return redirect(url_for("academic.index"))

    if not student_ids:
        flash("Select at least one student.", "error")
        return redirect(url_for("academic.index"))

    students = Student.query.filter(Student.id.in_(student_ids)).all()
    if len(students) != len(student_ids):
        flash("Some selected student records could not be found.", "error")
        return redirect(url_for("academic.index"))

    if action == "unassign":
        for student in students:
            student.batch_id = None
        message = f"Removed batch assignments for {len(students)} student(s)."
    elif action == "assign":
        batch = db.session.get(Batch, batch_id) if batch_id else None
        if batch is None or not batch.is_active:
            flash("Choose an active batch.", "error")
            return redirect(url_for("academic.index"))

        for student in students:
            student.batch_id = batch.id
        message = f"Assigned {len(students)} student(s) to {batch.name}."
    else:
        flash("Choose a valid enrollment action.", "error")
        return redirect(url_for("academic.index"))

    db.session.commit()
    flash(message, "success")
    return redirect(url_for("academic.index"))


@academic_bp.post("/students/<int:student_id>/password-setup-link")
@admin_required
def resend_student_password_link(student_id):
    import smtplib
    from email.message import EmailMessage
    from itsdangerous import URLSafeTimedSerializer

    student = db.session.get(Student, student_id)
    if student is None:
        abort(404)

    user = student.user
    if user is None or user.role != "student":
        flash("No student account is associated with this profile.", "error")
        return redirect(url_for("academic.index"))

    mail_server = current_app.config.get("MAIL_SERVER", "")
    mail_port = current_app.config.get("MAIL_PORT", 587)
    mail_username = current_app.config.get("MAIL_USERNAME", "")
    mail_password = current_app.config.get("MAIL_PASSWORD", "")
    sender = current_app.config.get("MAIL_DEFAULT_SENDER") or mail_username

    if not mail_server or not sender:
        flash("Email delivery is not configured. Check SMTP settings.", "error")
        return redirect(url_for("academic.index"))

    serializer = URLSafeTimedSerializer(current_app.config["SECRET_KEY"])
    token = serializer.dumps(
        {"user_id": user.id, "password_hash": user.password_hash},
        salt="campushub-student-password-setup",
    )
    setup_url = url_for("auth.password_setup", token=token, _external=True)

    message = EmailMessage()
    message["Subject"] = "Your CampusHub password setup link"
    message["From"] = sender
    message["To"] = user.email
    message.set_content(
        f"Hello {user.full_name},\n\n"
        "An administrator has requested a password setup/reset link for your "
        "CampusHub student account.\n\n"
        "Use this secure link within one hour:\n"
        f"{setup_url}\n\n"
        "If you did not expect this email, contact your campus administrator."
    )

    try:
        if mail_port == 465:
            connection = smtplib.SMTP_SSL(mail_server, mail_port, timeout=20)
        else:
            connection = smtplib.SMTP(mail_server, mail_port, timeout=20)
            connection.starttls()

        with connection as smtp:
            if mail_username:
                smtp.login(mail_username, mail_password)
            smtp.send_message(message)

        flash("Password setup/reset link emailed to the student's registered address.", "success")
    except Exception:
        current_app.logger.exception("Could not send student password setup email.")
        flash("Email could not be sent. Check SMTP configuration and application logs.", "error")

    return redirect(url_for("academic.index"))


